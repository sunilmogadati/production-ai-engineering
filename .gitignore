# ============================================================
#  Sensitive data — NEVER commit. Course data must be public/open
#  (World Bank etc). Any CSV/XLSX here is a red flag by default.
# ============================================================
*.csv
# Exception: World Bank OPEN data — safe & public, so the WB labs run with zero setup.
# (leads.csv stays ignored — it's synthetic, regenerated by ml01_generate_synthetic_data.py)
!hands-on/data/world_*.csv
*.xlsx
*.xls
*.env
.env*
# Exception: .env.example carries NAMES ONLY (no values) and must ship with a build,
# so a reader knows which variables to set. Verified by each build's fence tests.
!**/.env.example
*.key
*.pem
secrets*
credentials*

# Reference-only prior-cohort materials live OUTSIDE this repo
# (they contain PII + a live API key). Never vendor them in.
Quintrix-AI-Cohort1/
**/cohort1-raw/

# Third-party learning material (Pluralsight course code + slide PDFs, etc.).
# Co-located with our FastAPI content for convenience, but NEVER committed —
# it's someone else's copyright. See reference/README.md.
/reference/

# ============================================================
#  Heavy / generated / local
# ============================================================
venv/
.venv/
env/
__pycache__/
*.pyc
models/
*.pkl
*.joblib
.ipynb_checkpoints/
node_modules/
.DS_Store

# uv resolves the optional live/dev extras on demand; the offline path has no
# runtime dependencies, so a committed lock would only pin things nobody needs.
uv.lock
